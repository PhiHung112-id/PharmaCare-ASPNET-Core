@model IEnumerable<PharmaCare.Models.Drug>
@{
    ViewData["Title"] = "Thùng rác Thuốc";
    var categories = ViewBag.Categories as List<PharmaCare.Models.Category>;
}

<div class="container-fluid mt-4 fade-in">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 text-danger font-weight-bold">
            <span class="material-symbols-rounded align-middle" style="font-size: 2rem;">delete_sweep</span> Thùng rác Thuốc
        </h1>
        <a href="/danh-muc" class="btn btn-secondary btn-sm shadow-sm rounded-pill px-3">
            <i class="fas fa-arrow-left fa-sm"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow mb-4 border-left-danger rounded-25 border-0">
        <div class="card-header py-3 bg-white border-0">
            <h6 class="m-0 font-weight-bold text-danger">Các thuốc đã bị gỡ khỏi danh mục</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" width="100%">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="pl-4">Mã thuốc</th>
                            <th>Hình ảnh</th>
                            <th>Tên thuốc</th>
                            <th>Nhóm thuốc</th>
                            <th class="text-center pr-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center py-5 text-muted">Thùng rác hiện đang trống</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            var catName = categories?.FirstOrDefault(c => c.MaNhom == item.MaNhom)?.TenNhom ?? "Không xác định";

                            <tr>
                                <td class="pl-4 text-muted small font-weight-bold">@item.MaThuoc</td>
                                <td>
                                    <img src="@(!string.IsNullOrEmpty(item.HinhAnh) ? item.HinhAnh : "https://placehold.co/50x50?text=Thuốc")"
                                         class="shadow-sm" style="width:50px; height:50px; border-radius:8px; object-fit: cover;" />
                                </td>
                                <td class="font-weight-bold text-dark">@item.TenThuoc</td>
                                <td><span class="badge bg-light text-primary px-3 rounded-pill">@catName</span></td>
                                <td class="text-center pr-4">
                                    <!-- Nút Khôi phục -->
                                    <form action="/danh-muc/khoi-phuc-thuoc" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.MaThuoc" />
                                        <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm me-1" title="Khôi phục">
                                            <i class="fas fa-undo"></i> Khôi phục
                                        </button>
                                    </form>
                                    <!-- Nút Xóa vĩnh viễn -->
                                    <form action="/danh-muc/xoa-vinh-vien-thuoc" method="post" class="d-inline" onsubmit="return confirm('CẢNH BÁO: Xóa vĩnh viễn sẽ mất mọi dữ liệu lô hàng, đơn vị tính của thuốc này. Tiếp tục?');">
                                        <input type="hidden" name="id" value="@item.MaThuoc" />
                                        <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm" title="Xóa vĩnh viễn">
                                            <i class="fas fa-times"></i> Xóa vĩnh viễn
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>