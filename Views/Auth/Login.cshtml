@model PharmaCare.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Đăng nhập - Pharmacy Pro System</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Inter:400,500,600,700|Nunito:400,600,700,800&display=swap" rel="stylesheet">
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="/css/login.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


</head>

<body>

    <div class="particles" id="particles"></div>

    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-xl-10 col-lg-11">
                <div class="card-login">
                    <div class="row g-0">
                        <div class="col-lg-6 login-info-panel">
                            <div class="animated-logo">
                                <div class="logo-circle">
                                    <i class="fas fa-hospital-user"></i>
                                </div>
                                <h3 class="text-white mb-2 fw-bold" style="font-size: 24px;">Pharmacy Pro</h3>
                                <div class="typing-text">Hệ thống quản lý nhà thuốc thông minh</div>
                            </div>

                            <div class="mt-4">
                                <div class="feature-item">
                                    <i class="fas fa-capsules"></i>
                                    <span>Quản lý kho thuốc thông minh</span>
                                </div>
                                <div class="feature-item">
                                    <i class="fas fa-chart-line"></i>
                                    <span>Báo cáo doanh thu chi tiết</span>
                                </div>
                                <div class="feature-item">
                                    <i class="fas fa-shield-alt"></i>
                                    <span>Bảo mật an toàn tuyệt đối</span>
                                </div>
                                <div class="feature-item">
                                    <i class="fas fa-headset"></i>
                                    <span>Hỗ trợ 24/7</span>
                                </div>
                            </div>

                            <div class="mt-4">
                                <div class="row g-2">
                                    <div class="col-4">
                                        <div class="stat-card">
                                            <div class="stat-number">10K+</div>
                                            <div class="stat-label">Sản phẩm</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="stat-card">
                                            <div class="stat-number">500+</div>
                                            <div class="stat-label">Khách hàng</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="stat-card">
                                            <div class="stat-number">99.9%</div>
                                            <div class="stat-label">Uptime</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 text-center">
                                <small class="text-white-50">
                                    <i class="fas fa-lock me-1"></i> An toàn & Bảo mật tuyệt đối
                                </small>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="p-4 p-md-5">
                                <div class="text-center mb-4">
                                    <div class="d-inline-block p-3 rounded-circle mb-3" style="background: rgba(13, 148, 136, 0.1);">
                                        <i class="fas fa-sign-in-alt fa-2x" style="color: #0d9488;"></i>
                                    </div>
                                    <h4 class="login-title">Chào mừng trở lại!</h4>
                                    <p class="text-muted small">Vui lòng đăng nhập để tiếp tục</p>
                                </div>

                                @if (ViewBag.Error != null)
                                {
                                    <div class="alert-custom" style="background: #fee2e2; color: #dc2626; border-left: 4px solid #dc2626;">
                                        <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
                                    </div>
                                }

                                @if (TempData["Success"] != null)
                                {
                                    <div class="alert-custom" style="background: #dcfce7; color: #16a34a; border-left: 4px solid #16a34a;">
                                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                                    </div>
                                }

                                <form method="post" id="loginForm">
                                    @Html.AntiForgeryToken()

                                    <div class="form-group">
                                        <div class="input-group-custom">
                                            <span class="input-icon">
                                                <i class="fas fa-user"></i>
                                            </span>
                                            <input type="text" name="Username" placeholder="Tên đăng nhập"
                                                   value="@(Model?.Username ?? "")" required autofocus>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <div class="input-group-custom">
                                            <span class="input-icon">
                                                <i class="fas fa-lock"></i>
                                            </span>
                                            <input type="password" id="Password" name="Password" placeholder="Mật khẩu" required>
                                            <button type="button" class="toggle-password" id="togglePassword">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="form-group d-flex justify-content-between align-items-center">
                                        <label class="custom-checkbox">
                                            <input type="checkbox" name="RememberMe" value="true">
                                            <span>Ghi nhớ đăng nhập</span>
                                        </label>
                                        <a href="#" class="forgot-link" onclick="showForgotPassword(); return false;">
                                            <i class="fas fa-key me-1"></i>Quên mật khẩu?
                                        </a>
                                    </div>

                                    <button type="submit" class="btn-login" id="loginBtn">
                                        <i class="fas fa-sign-in-alt me-2"></i>ĐĂNG NHẬP
                                    </button>

                                    <div class="divider">
                                        <span>HOẶC</span>
                                    </div>

                                    <div class="text-center mt-2">
                                        <a class="small text-muted" asp-route="HomePage" style="text-decoration: none;">
                                            <i class="fas fa-home me-1"></i>Về trang chủ
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function() {
            createParticles();

            $('#togglePassword').click(function() {
                var passwordInput = $('#Password');
                var icon = $(this).find('i');

                if (passwordInput.attr('type') === 'password') {
                    passwordInput.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    passwordInput.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            $('#loginForm').on('submit', function() {
                var btn = $('#loginBtn');
                btn.html('<i class="fas fa-spinner fa-spin me-2"></i>ĐANG XỬ LÝ...');
                btn.prop('disabled', true);
                return true;
            });
        });

        function createParticles() {
            var particlesContainer = document.getElementById('particles');
            if (particlesContainer) {
                for (var i = 0; i < 50; i++) {
                    var particle = document.createElement('div');
                    particle.className = 'particle';
                    var size = Math.random() * 6 + 2;
                    particle.style.width = size + 'px';
                    particle.style.height = size + 'px';
                    particle.style.left = Math.random() * 100 + '%';
                    particle.style.top = Math.random() * 100 + '%';
                    particle.style.animationDelay = Math.random() * 5 + 's';
                    particle.style.animationDuration = Math.random() * 10 + 5 + 's';
                    particlesContainer.appendChild(particle);
                }
            }
        }

        function showForgotPassword() {
            Swal.fire({
                title: 'Quên mật khẩu?',
                text: 'Vui lòng liên hệ quản trị viên để được hỗ trợ!',
                icon: 'info',
                confirmButtonColor: '#0d9488',
                confirmButtonText: 'Đóng'
            });
        }

        $(document).keypress(function(e) {
            if (e.which == 13) {
                $('#loginForm').submit();
            }
        });
    </script>
</body>

</html>