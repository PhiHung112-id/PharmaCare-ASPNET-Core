@model PharmaCare.Models.Category
@{
    ViewData["Title"] = "Chi tiết Nhóm: " + Model.TenNhom;
    var drugs = ViewBag.DrugsInCat as List<PharmaCare.Models.Drug>;
}

<div class="container-fluid mt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Chi tiết nhóm: <span class="text-primary font-weight-bold">@Model.TenNhom</span></h1>
        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm shadow-sm rounded-pill px-3">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow border-0 rounded-25 mb-4">
                <div class="card-header py-3 bg-white border-0">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin cơ bản</h6>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-pills fa-4x text-gray-300"></i>
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted small">Mã nhóm:</span> <strong>@Model.MaNhom</strong>
                        </li>
                        <li class="list-group-item px-0">
                            <span class="text-muted small d-block mb-1">Mô tả:</span>
                            <span class="text-dark">@(string.IsNullOrEmpty(Model.GhiChu) ? "Không có mô tả" : Model.GhiChu)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted small">Trạng thái:</span>
                            <span class="@((Model.TrangThai ?? true) ? "text-success" : "text-danger") font-weight-bold">
                                @((Model.TrangThai ?? true) ? "Đang kinh doanh" : "Tạm dừng")
                            </span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom-0">
                            <span class="text-muted small">Tổng số mặt hàng:</span>
                            <span class="badge bg-primary rounded-pill px-3">@(drugs?.Count ?? 0)</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7">
            <div class="card shadow border-0 rounded-25 mb-4">
                <div class="card-header py-3 bg-white border-0">
                    <h6 class="m-0 font-weight-bold text-primary">Danh sách thuốc thuộc nhóm</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr>
                                    <th class="pl-4">Mã thuốc</th>
                                    <th>Tên thuốc</th>
                                    <th>Đơn vị</th>
                                    <th>Tồn kho</th>
                                    <th class="pr-4">Giá bán</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (drugs == null || !drugs.Any())
                                {
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có thuốc nào trong nhóm này</td></tr>
                                }
                                else
                                {
                                    foreach (var d in drugs)
                                    {
                                        <tr>
                                            <td class="pl-4 small text-muted">@d.MaThuoc</td>
                                            <td class="font-weight-bold"><a href="/danh-muc/chi-tiet/@d.MaThuoc" class="text-dark text-decoration-none">@d.TenThuoc</a></td>
                                            <td><span class="badge bg-light text-dark px-2">@d.DonVi</span></td>
                                            <td><span class="text-@(d.TonKho > 0 ? "success" : "danger") font-weight-bold">@d.TonKho</span></td>
                                            <td class="pr-4 font-weight-bold text-primary">@String.Format("{0:0,0}", d.GiaBan)đ</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="p-3 text-right border-top">
                        <p class="text-info small font-italic mb-0">* Dữ liệu này được liên kết trực tiếp với kho hàng.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>