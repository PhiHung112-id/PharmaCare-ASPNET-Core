@model PharmaCare.Models.StaffViewModel
@using System.Text.Json;
@{
    ViewData["Title"] = "Đội ngũ nhân viên";

    var staffListJson = Model?.StaffList?.Select(x => new
    {
        maNv = x.MaNv,
        hoTen = x.HoTen ?? "",
        taiKhoan = x.TaiKhoan ?? "",
        quyen = x.Quyen ?? ""
    }).ToList() ?? new();
}

<style>
    .rounded-25 {
        border-radius: 25px !important;
    }
</style>

<div class="container-fluid fade-in">
    <!-- 1. TOP TOOLBAR -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4 mt-3">
        <h1 class="h3 mb-0 text-gray-800 font-weight-bold">
            <span class="material-symbols-rounded text-navy align-middle" style="font-size: 2.5rem;">badge</span>
            Đội ngũ nhân viên
        </h1>

        <!-- Thanh Tìm Kiếm + Nút Thêm -->
        <div class="d-flex gap-2 align-items-center">
            <div class="input-group input-group-sm" style="width: 280px;">
                <span class="input-group-text bg-white border-end-0 rounded-start-pill ps-3">
                    <span class="material-symbols-rounded text-muted" style="font-size: 1.1rem;">search</span>
                </span>
                <input type="text" id="searchStaff" class="form-control border-start-0 rounded-end-pill" placeholder="Tìm tên, mã nhân viên...">
            </div>

            <button class="btn btn-primary shadow-sm px-4 rounded-pill border-0 mx-1" data-bs-toggle="modal" data-bs-target="#addStaffModal"
                    style="background: linear-gradient(135deg, #312e81 0%, #4338ca 100%);">
                <span class="material-symbols-rounded align-middle me-1">person_add</span> Thêm nhân viên
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-pill shadow-sm" role="alert">
            <span class="material-symbols-rounded align-middle me-2">check_circle</span> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 2. KHỐI THỐNG KÊ -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow-sm border-0 rounded-25 h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng nhân sự</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalStaff.ToString("N0") người</div>
                        </div>
                        <div class="col-auto">
                            <span class="material-symbols-rounded text-gray-300" style="font-size: 2.5rem;">group</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow-sm border-0 rounded-25 h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Đang làm việc</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ActiveStaff.ToString("N0") người</div>
                        </div>
                        <div class="col-auto">
                            <span class="material-symbols-rounded text-gray-300" style="font-size: 2.5rem;">assignment_ind</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. KHỐI BẢNG DANH SÁCH NHÂN VIÊN -->
    <div class="card shadow-sm mb-4 border-0 rounded-25 overflow-hidden">
        <div class="card-body p-0 d-flex flex-column">
            <div class="table-responsive flex-grow-1">
                <table class="table table-hover align-middle mb-0" id="staffTable">
                    <thead>
                        <tr class="text-uppercase small font-weight-bold text-muted border-0">
                            <th class="ps-4 py-3">Nhân viên</th>
                            <th class="py-3">Liên hệ</th>
                            <th class="py-3">Chức vụ</th>
                            <th class="py-3">Trạng thái</th>
                            <th class="text-center pe-4 py-3" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="staffTableBody">
                    </tbody>
                </table>
            </div>

            <!-- THANH PHÂN TRANG -->
            <div class="p-4 border-top bg-white mt-auto">
                <div class="d-sm-flex justify-content-between align-items-center">
                    <div class="small text-muted mb-3 mb-sm-0">
                        Hiển thị <span id="showingStart" class="font-weight-bold text-dark">0</span> - <span id="showingEnd" class="font-weight-bold text-dark">0</span> của <span id="totalRecords" class="font-weight-bold text-dark">0</span> nhân viên
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0 shadow-sm rounded-pill" id="pagination"></ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Nhân Viên -->
<div class="modal fade" id="addStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-25">
            <div class="modal-header border-0 p-4" style="border-radius: 25px 25px 0 0;">
                <h5 class="modal-title font-weight-bold text-navy">
                    <span class="material-symbols-rounded align-middle me-2">person_add</span> Cấp tài khoản nhân viên
                </h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Staff/Create" method="post">
                <div class="modal-body px-4 py-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="small font-weight-bold text-muted mb-2">HỌ VÀ TÊN</label>
                            <input type="text" class="form-control rounded-pill bg-light border-light px-3 py-2" name="FullName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="small font-weight-bold text-muted mb-2">VAI TRÒ / CHỨC VỤ</label>
                            <select class="form-select rounded-pill bg-light border-light px-3 py-2" name="RoleId">
                                <option value="1">Dược sĩ tư vấn</option>
                                <option value="2">Nhân viên bán hàng</option>
                                <option value="3">Quản lý kho</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="small font-weight-bold text-muted mb-2">TÊN ĐĂNG NHẬP</label>
                            <input type="text" class="form-control rounded-pill bg-light border-light px-3 py-2" name="Username" required>
                        </div>
                        <div class="col-md-6">
                            <label class="small font-weight-bold text-muted mb-2">MẬT KHẨU TẠM THỜI</label>
                            <input type="password" class="form-control rounded-pill bg-light border-light px-3 py-2" name="Password" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button class="btn btn-light rounded-pill px-4 border" type="button" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button class="btn btn-primary rounded-pill px-5 shadow border-0" type="submit" style="background: linear-gradient(135deg, #312e81 0%, #4338ca 100%);">LƯU NHÂN VIÊN</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Nhân Viên -->
<div class="modal fade" id="editStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-25">
            <div class="modal-header border-0 p-4" style="border-radius: 25px 25px 0 0;">
                <h5 class="modal-title font-weight-bold text-warning">
                    <span class="material-symbols-rounded align-middle me-2">manage_accounts</span> Chỉnh sửa nhân viên
                </h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Staff/Edit" method="post">
                <div class="modal-body px-4 py-4">
                    <input type="hidden" name="MaNv" id="editMaNv" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="small font-weight-bold text-muted mb-2">HỌ VÀ TÊN</label>
                            <input type="text" class="form-control rounded-pill bg-light border-light px-3 py-2" name="FullName" id="editFullName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="small font-weight-bold text-muted mb-2">VAI TRÒ / CHỨC VỤ</label>
                            <select class="form-select rounded-pill bg-light border-light px-3 py-2" name="RoleId" id="editRoleId">
                                <option value="1">Dược sĩ tư vấn</option>
                                <option value="2">Nhân viên bán hàng</option>
                                <option value="3">Quản lý kho</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="small font-weight-bold text-muted mb-2">TÊN ĐĂNG NHẬP (KHÔNG THỂ ĐỔI)</label>
                            <input type="text" class="form-control rounded-pill bg-light border-light px-3 py-2 text-muted" id="editUsername" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="small font-weight-bold text-muted mb-2">CẤP LẠI MẬT KHẨU MỚI (Tùy chọn)</label>
                            <input type="password" class="form-control rounded-pill bg-light border-light px-3 py-2" name="Password" placeholder="Bỏ trống nếu không đổi">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button class="btn btn-light rounded-pill px-4 border" type="button" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button class="btn btn-warning rounded-pill px-5 shadow border-0 text-dark font-weight-bold" type="submit">CẬP NHẬT</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/site-pagination.js"></script>

    <script>
        let staffData = @Html.Raw(JsonSerializer.Serialize(staffListJson));
        const rowsPerPage = 5; 
        let currentPage = 1;
        let searchQuery = "";

        document.addEventListener("DOMContentLoaded", () => {
            renderTable();

            const searchInput = document.getElementById('searchStaff');
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    searchQuery = e.target.value.toLowerCase();
                    currentPage = 1;
                    renderTable();
                });
            }
        });

        function staffRowTemplate(item, index) {
            let initials = "NV";
            if (item.hoTen) {
                let names = item.hoTen.trim().split(/\s+/);
                if (names.length >= 2) initials = names[names.length - 2].charAt(0) + names[names.length - 1].charAt(0);
                else if (names.length === 1) initials = names[0].substring(0, 2);
            }
            initials = initials.toUpperCase();

            return `
                <tr>
                    <td class="align-middle ps-4">
                        <div class="d-flex align-items-center">
                            <div class="me-3 d-flex align-items-center justify-content-center fw-bold rounded-circle shadow-sm"
                                 style="width: 45px; height: 45px; background: #e0e7ff; color: #3730a3;">
                                ${initials}
                            </div>
                            <div>
                                <b class="text-dark">${item.hoTen}</b><br>
                                <small class="text-muted">Mã NV: ${item.maNv}</small>
                            </div>
                        </div>
                    </td>
                    <td class="align-middle">
                        <span class="small text-muted d-flex align-items-center">
                            <span class="material-symbols-rounded me-1" style="font-size: 1rem;">person_outline</span> User: ${item.taiKhoan || "N/A"}
                        </span>
                    </td>
                    <td class="align-middle">
                        <span class="badge bg-light text-primary px-3 py-2 rounded-pill border border-light">${item.quyen || "Nhân viên"}</span>
                    </td>
                    <td class="align-middle">
                        <span class="badge rounded-pill bg-success text-white px-3 py-2 d-inline-flex align-items-center" style="font-size: 0.75rem;">
                            <span class="material-symbols-rounded me-1" style="font-size: 1.1rem;">how_to_reg</span> Đang làm việc
                        </span>
                    </td>
                    <td class="align-middle text-center pe-4">
                        <div class="d-flex justify-content-center align-items-center">

                            <!-- Nút Sửa -->
                            <button class="btn btn-sm btn-light text-warning rounded shadow-sm mx-1"
                                    onclick="openEditModal('${item.maNv}', '${item.hoTen}', '${item.taiKhoan}', '${item.quyen}')" title="Sửa thông tin">
                                <span class="material-symbols-rounded align-middle" style="font-size: 1.2rem;">manage_accounts</span>
                            </button>

                            <!-- Nút Xóa  -->
                            <form action="/Staff/Delete" method="post" class="m-0 p-0 d-inline-flex"
                                  onsubmit="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn xóa nhân viên ${item.hoTen} không? Hành động này không thể hoàn tác!');">
                                <input type="hidden" name="MaNv" value="${item.maNv}" />
                                <button type="submit" class="btn btn-sm btn-light text-danger rounded shadow-sm mx-1" title="Xóa tài khoản">
                                    <span class="material-symbols-rounded align-middle" style="font-size: 1.2rem;">person_remove</span>
                                </button>
                            </form>

                        </div>
                    </td>
                </tr>
            `;
        }

        // 3. GỌI HÀM PHÂN TRANG
        function renderTable() {
            const filteredData = staffData.filter(s =>
                s.hoTen.toLowerCase().includes(searchQuery) ||
                s.maNv.toLowerCase().includes(searchQuery) ||
                s.taiKhoan.toLowerCase().includes(searchQuery)
            );

            commonPagination(
                filteredData,
                currentPage,
                rowsPerPage,
                'staffTableBody',
                'pagination',
                staffRowTemplate,
                'changePage'
            );
        }

        function changePage(p) {
            currentPage = p;
            renderTable();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 4. HÀM MỞ MODAL SỬA
        function openEditModal(maNv, hoTen, taiKhoan, quyen) {
            document.getElementById('editMaNv').value = maNv;
            document.getElementById('editFullName').value = hoTen;
            document.getElementById('editUsername').value = taiKhoan;

            let roleId = 4;
            if (quyen === 'Dược sĩ tư vấn') roleId = 1;
            else if (quyen === 'Nhân viên bán hàng') roleId = 2;
            else if (quyen === 'Quản lý kho') roleId = 3;
            document.getElementById('editRoleId').value = roleId;

            var editModal = new bootstrap.Modal(document.getElementById('editStaffModal'));
            editModal.show();
        }
    </script>
}