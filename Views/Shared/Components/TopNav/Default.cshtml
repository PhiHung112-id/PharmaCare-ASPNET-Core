@{
    var fullName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Khách";
    var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Chưa rõ";

    string initials = "??";
    if (!string.IsNullOrEmpty(fullName) && fullName != "Khách")
    {
        var names = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (names.Length >= 2)
        {
            initials = names[names.Length - 2].Substring(0, 1) + names[names.Length - 1].Substring(0, 1);
        }
        else if (names.Length == 1)
        {
            initials = names[0].Substring(0, Math.Min(2, names[0].Length));
        }
    }
}

